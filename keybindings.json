// Place your key bindings in this file to override the defaults
[
    // Back/forward navigation when looking through code.
    //
    // For some stupid reason, Linux has different defaults for forward and
    // backward navigation. Removing these defaults for something more sane.
    // Plus, I've remapped them to something else anyway.
    {
        "key": "alt+left",
        "command": "workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "alt+right",
        "command": "workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        "key": "ctrl+alt+-",
        "command": "-workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "ctrl+shift+-",
        "command": "-workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    // Creating multiple cursors up and down from the current cursor.
    // Linux had both ctrl+shift+up/down and shift+alt+up/down. It didn't really
    // make sense to have two, and I didn't like either. Changing them for the
    // windows variant (plus will use one of them for indent jump). On windows
    // the shift+alt ones are used to duplicate a block of text below or above,
    // which is very useful to me.
    // removal
    {
        "key": "ctrl+shift+up",
        "command": "-editor.action.insertCursorAbove",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+down",
        "command": "-editor.action.insertCursorBelow",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+up",
        "command": "-editor.action.insertCursorAbove",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+down",
        "command": "-editor.action.insertCursorBelow",
        "when": "editorTextFocus"
    },
    // new
    {
        "key": "ctrl+alt+up",
        "command": "editor.action.insertCursorAbove",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+alt+down",
        "command": "editor.action.insertCursorBelow",
        "when": "editorTextFocus"
    },
    {
        "key": "shift+alt+up",
        "command": "editor.action.copyLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "shift+alt+down",
        "command": "editor.action.copyLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    // Helpful for resizing a particular window.
    {
        "key": "ctrl+alt+=",
        "command": "workbench.action.increaseViewSize"
    },
    {
        "key": "ctrl+alt+-",
        "command": "workbench.action.decreaseViewSize"
    },
    // This just makes sure it's created in the directory you are in, or in the
    // same folder the current file you're viewing is in.
    {
        "key": "ctrl+n",
        "command": "explorer.newFile",
        "when": "editorFocus || sideBarFocus"
    },
    {
        "key": "ctrl+k ctrl+n",
        "command": "explorer.newFolder",
        "when": "editorFocus || sideBarFocus"
    },
    // If this is ever needed for whatever reason
    {
        "key": "ctrl+alt+n",
        "command": "workbench.action.files.newUntitledFile"
    },
    {
        "key": "ctrl+k ctrl+/",
        "command": "editor.action.blockComment",
        "when": "textInputFocus"
    },
    // I think this is the same as ctrl+p so why have it
    {
        "key": "ctrl+e",
        "command": "-workbench.action.quickOpen"
    },
    // Sometimes useful if the formatter is stupid (and previous binding removed)
    {
        "key": "ctrl+k ctrl+s",
        "command": "workbench.action.files.saveWithoutFormatting"
    },
    {
        "key": "ctrl+k ctrl+shift+s",
        "command": "-workbench.action.files.saveWithoutFormatting"
    },
    // This is really not needed.
    {
        "key": "ctrl+k ctrl+s",
        "command": "-workbench.action.openGlobalKeybindings"
    },
    // I use these with global search. I never understood why file search has
    // it but global search does not. Took a while to find the proper condition
    {
        "key": "f3",
        "command": "search.action.focusNextSearchResult",
        "when": "view.workbench.view.search.visible && (hasSearchResult || inSearchEditor)"
    },
    {
        "key": "shift+f3",
        "command": "search.action.focusPreviousSearchResult",
        "when": "view.workbench.view.search.visible && (hasSearchResult || inSearchEditor)"
    },
    // This is kind of a vim visual mode. Sometimes you don't have version
    // control and just want to read a file
    {
        "key": "ctrl+k escape",
        "command": "workbench.action.files.toggleActiveEditorReadonlyInSession",
        "when": "activeEditorCanToggleReadonly && editorFocus && textInputFocus"
    },
    // Make ctrl+pageup stay in the same editor group. You change groups with
    // something like ctrl + 2 anyway.
    // To move an editor between groups use the default shortcut which is 
    // ctrl + alt + left/right
    {
        "key": "ctrl+pageup",
        "command": "-workbench.action.previousEditor"
    },
    {
        "key": "ctrl+pagedown",
        "command": "-workbench.action.nextEditor"
    },
    // Tbh these may as well stay unset. This key combination is fucking
    // retarded
    {
        "key": "ctrl+k ctrl+pageup",
        "command": "-workbench.action.previousEditorInGroup"
    },
    {
        "key": "ctrl+k ctrl+pagedown",
        "command": "-workbench.action.nextEditorInGroup"
    },
    // swap default
    {
        "key": "ctrl+pageup",
        "command": "workbench.action.previousEditorInGroup"
    },
    {
        "key": "ctrl+pagedown",
        "command": "workbench.action.nextEditorInGroup"
    },
    {
        "key": "ctrl+k ctrl+pageup",
        "command": "workbench.action.previousEditor"
    },
    {
        "key": "ctrl+k ctrl+pagedown",
        "command": "workbench.action.nextEditor"
    },
    // requires indent-jump, commented to not mess up shortcuts until installed
    {
        "key": "ctrl+up",
        "command": "indent-jump.moveUp"
    },
    {
        "key": "ctrl+down",
        "command": "indent-jump.moveDown"
    },
    {
        "key": "ctrl+shift+up",
        "command": "indent-jump.selectUp"
    },
    {
        "key": "ctrl+shift+down",
        "command": "indent-jump.selectDown"
    },
    // Copying paths is a complete mess on Linux. Why the fuck have two different
    // shortcuts for the same thing in different contexts??
    // This uses my own preference for default file path copying which is
    // shift+alt+c
    {
        "key": "ctrl+alt+c",
        "command": "-copyFilePath",
        "when": "!editorFocus"
    },
    {
        "key": "ctrl+k ctrl+alt+c",
        "command": "-copyFilePath",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+shift+alt+c",
        "command": "-copyRelativeFilePath",
        "when": "!editorFocus"
    },
    {
        "key": "ctrl+k ctrl+shift+alt+c",
        "command": "-copyRelativeFilePath",
        "when": "editorFocus"
    },
    // my preference (just what I got used to)
    {
        "key": "ctrl+k shift+alt+c",
        "command": "copyRelativeFilePath"
    },
    {
        "key": "shift+alt+c",
        "command": "copyFilePath"
    },
    // my shortcut preferences
    {
        "key": "ctrl+'",
        "command": "addToAgentContext.pickAction",
        "when": "editorTextFocus && !auxiliaryBarVisible"
    },
    {
        "key": "ctrl+'",
        "command": "addToAgentContext.sendToAgent",
        "args": "claude",
        "when": "editorTextFocus && auxiliaryBarVisible && activeAuxiliary == workbench.view.extension.claude-sidebar-secondary"
    },
    {
        "key": "ctrl+'",
        "command": "addToAgentContext.sendToAgent",
        "args": "codex",
        "when": "editorTextFocus && auxiliaryBarVisible && activeAuxiliary == workbench.view.extension.codexSecondaryViewContainer"
    },
    // These are needed because ctrl+up and ctrl+down are modified with the
    // indent-jump extension. Plus I always keep my cursor at the center
    // of the screen with a config so this is a bit messed up.
    {
        "key": "ctrl+alt+pageDown",
        "command": "scrollLineDown",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+alt+pageUp",
        "command": "scrollLineUp",
        "when": "textInputFocus"
    }
]